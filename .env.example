PORT=4000
CORS_ORIGIN=http://localhost:3000

# Arc RPC endpoint (testnet or mainnet)
ARC_RPC_URL=
ARC_CHAIN_ID=

# Prisma reads this directly — include ?schema=public (or your schema name)
DATABASE_URL=postgresql://user:password@localhost:5432/warden?schema=public

# Deployed contract addresses
POLICY_REGISTRY_ADDRESS=
SPEND_GUARD_ADDRESS=
AUDIT_LOG_ADDRESS=

# Server-held keys. ADMIN sets policies/allowlists; APPROVER signs off on
# escalated payments. Keep these in a secrets manager in any real deployment
# — never commit them, and never reuse the same key for both roles.
ADMIN_PRIVATE_KEY=
APPROVER_PRIVATE_KEY=

# API keys for service callers without Clerk accounts (per-credential
# identity, role:label:key — generate labels with scripts/generate-api-keys.mjs).
# Humans authenticate via Clerk sessions or short-lived scoped tokens
# (POST /auth/token) instead. Send as the x-api-key header or Bearer token.
# Rotate immediately if either leaks.
WARDEN_API_KEYS=

# Network the contracts live on. Testnet is ungated by design; on mainnet
# every money-moving route requires a verified organization (§7).
WARDEN_NETWORK=testnet

# Request signing (replay protection) for api-key auth. Send all three headers;
# they are always verified when present (partial sets are rejected):
#   x-timestamp:  unix ms as a string
#   x-nonce:      >= 16 random chars, unique per request
#   x-signature:  hex HMAC-SHA256(apiKey, `${timestamp}.${nonce}.${sha256(body)}`)
# where sha256(body) is over the exact JSON string sent (JSON.stringify of the
# request object), or sha256("") when there is no body. Signatures older than
# 5 minutes or reusing a nonce are rejected with 401.
#
# Enforcement of signing on unsigned requests — set at least ONE:
#   REQUIRE_SIGNED_REQUESTS=true           reject unsigned requests now
#   UNSIGNED_REQUESTS_ALLOWED_UNTIL=<ISO>  accept unsigned requests only until
#                                          this deadline passes (e.g.
#                                          2026-10-01T00:00:00Z), then reject
#                                          automatically, no redeploy needed.
# With neither set, unsigned requests are accepted indefinitely (warned at
# boot). See scripts/signed-request-example.mjs for a reference signer.
REQUIRE_SIGNED_REQUESTS=false
UNSIGNED_REQUESTS_ALLOWED_UNTIL=

# ---------------------------------------------------------------------------
# Human auth: Clerk (Google OAuth, organizations, roles)
# ---------------------------------------------------------------------------

# Clerk — manages human auth, organizations, and role-based access.
# Get keys from https://dashboard.clerk.com → API Keys
# Without CLERK_SECRET_KEY, human sign-in is disabled (API key auth still works).
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Circle Wallets — embedded wallets for human users (same infra as agent custody).
# Each human gets one embedded wallet, provisioned automatically on first login;
# no seed phrase is ever shown — the user authorizes via PIN/passkey in the frontend SDK.
# Without these, human auth still works but wallets report `unavailable` and stay pending.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=
CIRCLE_BLOCKCHAIN=ETH-SEPOLIA
CIRCLE_USDC_TOKEN_ID=

# JWT signing key — always required. Signs the short-lived org-scoped
# session tokens issued by POST /auth/token (§6).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
