PORT=4000
CORS_ORIGIN=http://localhost:3000

# Arc RPC endpoint (testnet or mainnet)
ARC_RPC_URL=
ARC_CHAIN_ID=

# Prisma reads this directly — include ?schema=public (or your schema name)
DATABASE_URL=postgresql://user:password@localhost:5432/warden?schema=public

# Deployed contract addresses
POLICY_REGISTRY_ADDRESS=
SPEND_GUARD_ADDRESS=
AUDIT_LOG_ADDRESS=

# Server-held keys. ADMIN sets policies/allowlists; APPROVER signs off on
# escalated payments. Keep these in a secrets manager in any real deployment
# — never commit them, and never reuse the same key for both roles.
ADMIN_PRIVATE_KEY=
APPROVER_PRIVATE_KEY=

# API keys gating who can call the admin/approver write routes at all —
# separate from the chain keys above. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Send as the x-api-key header. Rotate immediately if either leaks.
ADMIN_API_KEY=
APPROVER_API_KEY=

# Preferred over the two legacy keys above: named per-person credentials, so
# the audit trail records *which* person did something, not just which role.
# Comma-separated, each entry `role:label:key[:maxApproval]`, e.g.:
#   WARDEN_API_KEYS=approver:alice:9f1c...:5000000000,admin:bob:ab12...
# - maxApproval (optional, approvers only) caps that credential to approvals
#   at or below the amount, in on-chain base units (USDC = 6 decimals).
# - Rotation: add the new key as a second entry for the same role, deploy,
#   then remove the old one — both are valid during the window.
# When set, the legacy ADMIN_API_KEY/APPROVER_API_KEY are ignored.
WARDEN_API_KEYS=

# Optional request signing (replay protection). When a client sends all three
# headers they are verified; unsigned requests are accepted during migration.
#   x-timestamp:  unix ms as a string
#   x-nonce:      >= 16 random chars, unique per request
#   x-signature:  hex HMAC-SHA256(apiKey, `${timestamp}.${nonce}.${sha256(body)}`)
# where sha256(body) is over the exact JSON string sent (JSON.stringify of the
# request object), or sha256("") when there is no body. Signatures older than
# 5 minutes or reusing a nonce are rejected with 401.
