# Arc Network Configuration
ARC_RPC_URL=https://arc-testnet.circle.com
ARC_CHAIN_ID=1234567890 # Replace with actual Arc chain ID

# Deployment Configuration
ADMIN_PRIVATE_KEY=0x... # Your admin wallet private key
APPROVER_PRIVATE_KEY=0x... # Your approver wallet private key

# USDC ERC-20 interface used by SpendGuard to settle payments.
# Omit to use Arc's canonical address (0x3600000000000000000000000000000000000000).
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Contract Addresses (filled after deployment)
POLICY_REGISTRY_ADDRESS=0x...
SPEND_GUARD_ADDRESS=0x...
AUDIT_LOG_ADDRESS=0x...