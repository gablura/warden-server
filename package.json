{
  "name": "@warden/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "postinstall": "prisma generate",
    "abis:generate": "node scripts/generate-abis.mjs",
    "keys:generate": "node scripts/generate-api-keys.mjs",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "create-wallet": "node --env-file=.env create-wallet.ts"
  },
  "dependencies": {
    "@circle-fin/developer-controlled-wallets": "^10.8.0",
    "@clerk/backend": "^3.17.2",
    "@fastify/cors": "^10.0.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/websocket": "^11.0.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "pg": "^8.13.0",
    "svix": "^2.5.0",
    "viem": "^2.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/pg": "^8.11.10",
    "prisma": "^7.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
