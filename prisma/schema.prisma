datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// USDC amounts are stored as raw on-chain base units (6 decimals) using
// BigInt, not Decimal/Float — this avoids any floating-point precision
// loss on values that come straight off the chain as uint256.

model Agent {
  address             String   @id
  organizationId      String?  @map("organization_id")
  label               String?
  dailyCap            BigInt   @map("daily_cap")
  perTxCap            BigInt   @map("per_tx_cap")
  escalationThreshold BigInt   @map("escalation_threshold")
  spentToday          BigInt   @default(0) @map("spent_today")
  status              String   @default("active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@map("agents")
}

model Event {
  id           Int      @id @default(autoincrement())
  agent        String
  counterparty String
  amount       BigInt
  decision     String
  timestamp    DateTime @default(now())
  txHash       String   @map("tx_hash")

  @@index([agent])
  @@index([timestamp])
  @@index([agent, timestamp])
  @@index([timestamp, id])
  @@map("events")
}

model PendingRequest {
  requestId    BigInt   @id @map("request_id")
  agent        String
  counterparty String
  amount       BigInt
  resolved     Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([resolved])
  @@index([resolved, createdAt])
  @@map("pending_requests")
}

model IndexerCheckpoint {
  /// Last block this watcher fully processed (all its events applied).
  /// On boot the watcher backfills from lastBlock + 1, so a restart can
  /// never silently skip events. Blocks with a failed event hold the
  /// checkpoint back until they process cleanly.
  watcher   String @id
  lastBlock BigInt @map("last_block")

  @@map("indexer_checkpoints")
}

/// Idempotency marker for indexer event processing: one row per (tx, log
/// index), inserted before any side effect. A unique violation here means
/// the event was already applied — so re-running a backfill or replaying a
/// block range can never double-increment spentToday or duplicate audit
/// rows. Rows are tiny and append-only per on-chain event.
model ProcessedLog {
  txHash      String   @map("tx_hash")
  logIndex    Int      @map("log_index")
  watcher     String
  processedAt DateTime @default(now()) @map("processed_at")

  @@id([txHash, logIndex])
  @@map("processed_logs")
}

model OperatorAction {
  id            Int      @id @default(autoincrement())
  operatorId    String   @map("operator_id")
  operatorLabel String   @map("operator_label")
  role          String
  action        String
  subjectId     String   @map("subject_id")
  txHash        String?  @map("tx_hash")
  correlationId String?  @map("correlation_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([operatorId])
  @@index([correlationId])
  @@map("operator_actions")
}

model Allowlist {
  agent        String
  counterparty String
  allowed      Boolean

  @@id([agent, counterparty])
  @@map("allowlist")
}

// ---------------------------------------------------------------------------
// Human auth: Clerk + Circle embedded wallets
// ---------------------------------------------------------------------------

/// A human user. Authenticated via Clerk (Google OAuth, etc.).
/// Roles are per-organization via Membership, not global on this model.
model User {
  id            String   @id @default(cuid())
  clerkId       String?  @unique
  email         String   @unique
  label         String?
  walletAddress String?  @unique
  walletId      String?  @unique
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  nonces     Nonce[]
  memberships Membership[]

  @@map("users")
}

model Nonce {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  nonce     String   @unique
  used      Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])

  @@map("nonces")
}

// ---------------------------------------------------------------------------
// Multi-tenancy: Organizations + Memberships
// ---------------------------------------------------------------------------

/// A company/team using Warden. Owns its own agents and policies.
/// The `verified` flag gates production/mainnet access — testnet is
/// available immediately, real money requires review.
model Organization {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  name      String
  slug      String   @unique
  verified  Boolean  @default(false)

  // Mainnet contract addresses — populated after verification.
  mainnetPolicyRegistry String? @map("mainnet_policy_registry")
  mainnetSpendGuard     String? @map("mainnet_spend_guard")
  mainnetAuditLog       String? @map("mainnet_audit_log")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships Membership[]
  agents      Agent[]

  @@map("organizations")
}

/// Join table: a user belongs to an organization with a specific role.
/// Roles: owner, admin, approver, viewer.
/// The same person can be an Admin in one org and a Viewer in another.
model Membership {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  organizationId String   @map("organization_id")
  role           String   @default("viewer")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("memberships")
}
