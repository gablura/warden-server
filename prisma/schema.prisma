datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// USDC amounts are stored as raw on-chain base units (6 decimals) using
// BigInt, not Decimal/Float — this avoids any floating-point precision
// loss on values that come straight off the chain as uint256.

model Agent {
  address             String   @id
  organizationId      String?  @map("organization_id")
  label               String?
  dailyCap            BigInt   @map("daily_cap")
  perTxCap            BigInt   @map("per_tx_cap")
  escalationThreshold BigInt   @map("escalation_threshold")
  spentToday          BigInt   @default(0) @map("spent_today")
  status              String   @default("active")
  circleWalletId      String?  @map("circle_wallet_id")

  // FK index: keeps org-scoped agent lookups and the org deployment
  // resolver fast. (The index existed in the DB but was never declared here,
  // so every `migrate diff` reported it as drift.)
  @@index([organizationId])
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@map("agents")
}

model Event {
  id           Int      @id @default(autoincrement())
  agent        String
  counterparty String
  amount       BigInt
  decision     String
  timestamp    DateTime @default(now())
  txHash       String   @map("tx_hash")

  @@index([agent])
  @@index([timestamp])
  @@index([agent, timestamp])
  @@index([timestamp, id])
  @@map("events")
}

model PendingRequest {
  /// Which contract deployment the request lives on: the org id for a
  /// per-org mainnet deployment, "global" for the env-configured one.
  /// Part of the primary key because request ids are per-deployment
  /// on-chain counters — two deployments can mint the same numeric id.
  deploymentKey String   @default("global") @map("deployment_key")
  requestId     BigInt   @map("request_id")
  agent         String
  counterparty  String
  amount        BigInt
  resolved      Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")

  @@id([deploymentKey, requestId])
  @@index([deploymentKey, resolved])
  @@index([deploymentKey, resolved, createdAt])
  @@map("pending_requests")
}

model IndexerCheckpoint {
  /// Last block this watcher fully processed (all its events applied).
  /// On boot the watcher backfills from lastBlock + 1, so a restart can
  /// never silently skip events. Blocks with a failed event hold the
  /// checkpoint back until they process cleanly.
  watcher   String @id
  lastBlock BigInt @map("last_block")

  @@map("indexer_checkpoints")
}

/// Idempotency marker for indexer event processing: one row per (tx, log
/// index), inserted before any side effect. A unique violation here means
/// the event was already applied — so re-running a backfill or replaying a
/// block range can never double-increment spentToday or duplicate audit
/// rows. Rows are tiny and append-only per on-chain event.
model ProcessedLog {
  txHash      String   @map("tx_hash")
  logIndex    Int      @map("log_index")
  watcher     String
  processedAt DateTime @default(now()) @map("processed_at")

  @@id([txHash, logIndex])
  @@map("processed_logs")
}

model OperatorAction {
  id            Int      @id @default(autoincrement())
  operatorId    String   @map("operator_id")
  operatorLabel String   @map("operator_label")
  role          String
  action        String
  subjectId     String   @map("subject_id")
  txHash        String?  @map("tx_hash")
  correlationId String?  @map("correlation_id")
  // The embedded wallet address of the human who triggered the action, when
  // known (Clerk-authenticated users). Binds the server-side audit row to
  // the specific person's key — the "who approved this" half of the wallet
  // layer. Null for API-key callers, which have no wallet.
  walletAddress String?  @map("wallet_address")
  // The actual on-chain msg.sender and how it signed: "circle" (the
  // person's embedded wallet via Circle) or "relayer" (server-held key).
  // Together with walletAddress this answers "whose key signed" exactly.
  signerAddress String?  @map("signer_address")
  signingVia    String?  @map("signing_via")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([operatorId])
  @@index([correlationId])
  @@map("operator_actions")
}

model Allowlist {
  agent        String
  counterparty String
  allowed      Boolean

  @@id([agent, counterparty])
  @@map("allowlist")
}

// ---------------------------------------------------------------------------
// Human auth: Clerk + Circle embedded wallets
// ---------------------------------------------------------------------------

/// A human user. Authenticated via Clerk (Google OAuth, etc.).
/// Roles are per-organization via Membership, not global on this model.
///
/// Wallet model (see src/auth/wallet.ts): every user gets exactly one
/// developer-controlled Circle wallet (`walletAddress`/`walletId`, both
/// unique and nullable until provisioning completes). The server authorizes
/// every wallet operation via its entity secret — end users never see a PIN
/// or passkey prompt. `externalWalletAddress` is an optional user-linked
/// wallet/multisig (Fireblocks, Safe) used as an add-on, never as a
/// replacement for the embedded wallet.
model User {
  id                   String   @id @default(cuid())
  clerkId              String?  @unique
  email                String   @unique
  label                String?
  walletAddress        String?  @unique
  walletId             String?  @unique
  externalWalletAddress String? @map("external_wallet_address")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  memberships Membership[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Multi-tenancy: Organizations + Memberships
// ---------------------------------------------------------------------------

/// A company/team using Warden. Owns its own agents and policies.
/// The `verified` flag gates production/mainnet access — testnet is
/// available immediately, real money requires review.
model Organization {
  id        String   @id @default(cuid())
  // camelCase column (no @map) — this field was created once as "clerk_id"
  // by a hand-written migration and every Clerk-authenticated org query
  // failed with P2022 "column clerkId does not exist" until the
  // reconciliation migration renamed it. Kept unmapped so the drift can't
  // silently come back.
  clerkId   String   @unique
  name      String
  slug      String   @unique
  verified  Boolean  @default(false)

  // Mainnet deployment — populated after verification. The three contract
  // addresses plus the RPC URL/chain id form one complete unit: an org uses
  // its own deployment only when ALL FIVE are set (see
  // chain/orgContracts.ts). Partial config never silently routes to the
  // global deployment — it fails closed.
  mainnetPolicyRegistry String? @map("mainnet_policy_registry")
  mainnetSpendGuard     String? @map("mainnet_spend_guard")
  mainnetAuditLog       String? @map("mainnet_audit_log")
  mainnetRpcUrl         String? @map("mainnet_rpc_url")
  mainnetChainId        Int?    @map("mainnet_chain_id")

  // Optional org-level treasury wallet/multisig (Fireblocks, Safe) linked
  // as an add-on for treasury-level actions. Never replaces the per-person
  // embedded wallets used for individual approvals.
  treasuryWallet String? @map("treasury_wallet")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships Membership[]
  agents      Agent[]
  invitations Invitation[]

  @@map("organizations")
}

/// Join table: a user belongs to an organization with a specific role.
/// Roles: owner, admin, approver, viewer.
/// The same person can be an Admin in one org and a Viewer in another.
model Membership {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  organizationId String   @map("organization_id")
  role           String   @default("viewer")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("memberships")
}

/// An invitation for an email address to join an organization with a
/// specific role (defaulting to `viewer` when the inviter doesn't say).
/// Accepting an invite creates a Membership — and only a Membership (see
/// §4 of the auth architecture: nothing here grants on-chain permissions).
///
/// Invites are token-based so joining works with or without Clerk email
/// delivery: the invite link carries `token`, and any pending (unexpired,
/// unaccepted) invite matching a user's email is also claimed automatically
/// on their next login.
model Invitation {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  email          String
  role           String    @default("viewer")
  token          String    @unique
  expiresAt      DateTime  @map("expires_at")
  acceptedAt     DateTime? @map("accepted_at")
  createdById    String?   @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// API-key request signing (src/auth/requestSignature.ts)
// ---------------------------------------------------------------------------

/// Replay protection for HMAC-signed API requests: one row per accepted
/// nonce, unique on the nonce itself so concurrent replicas race safely —
/// exactly one insert wins and the duplicate is rejected as a replay.
/// Rows expire with the signature freshness window and are swept
/// opportunistically; the (indexed) table stays roughly
/// (requests per 5 minutes) in size.
///
/// This is deliberately in the database, not per-process memory: memory
/// loses the replay window on every restart and is not shared across
/// replicas, so a captured request could be replayed against another
/// replica within the window it would still validate.
model SignatureNonce {
  nonce     String   @id
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("signature_nonces")
}
